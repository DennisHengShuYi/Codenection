# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Vite inlines every VITE_-prefixed value into the browser bundle verbatim, so the prefix
# is a security boundary rather than a naming convention: only values safe to publish may
# carry it. The Supabase anon key is designed to be public and is safe. The two below it
# are not, and must never gain the prefix.

# Client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only -- /api routes and migrations. Never VITE_-prefixed.
# The connection string carries the database password; the Groq key is billable.
#
# Nothing in this repository reads the connection string: there is no migration runner, so
# the files in supabase/migrations are applied by hand and this is the credential a person
# needs to do it. Said plainly because a grep for it finds only comments, which reads as a
# dead key rather than as a human's one.
SUPABASE_DIRECT_CONNECTION_STRING=
# Read by api/plan.ts, api/read-photo.ts and api/draft.ts -- nothing else, ever.
# Leave it unset and two of the three still work: the planner falls back to its rule-based
# parser and the request box to its templates. Photo import has no such fallback -- reading
# an image needs the model -- so it says so plainly rather than guessing at contents.
GROQ_API_KEY=

# Only used by `npm run test:integration`, which runs the storage contract against a real
# Supabase project. Use a throwaway account: the contract clears the store before every
# test, so whatever this account owns is deleted. Never a real student's login.
INTEGRATION_TEST_EMAIL=
INTEGRATION_TEST_PASSWORD=

# The Telegram bot (§13). Read only by api/telegram.ts. Never VITE_-prefixed: the bot token
# lets anyone send as the bot, and the service-role key bypasses row-level security
# entirely, so whoever holds it can read and write every student's week.
#
# Leave them unset and the webhook answers 503 rather than erroring, which is the state CI
# and the demo both run in -- the app itself is unaffected either way.
TELEGRAM_BOT_TOKEN=
# Any long random string you invent. Telegram sends it back on every call, and it is the
# only thing standing between this endpoint and anyone on the internet.
TELEGRAM_WEBHOOK_SECRET=
# Supabase dashboard, Project Settings, API. The most dangerous value in this file.
SUPABASE_SERVICE_ROLE_KEY=
# Authorises the daily digest, which vercel.json runs at 01:00 UTC -- 9am in Malaysia (§9).
# Any long random string you invent, and not one already used above. The endpoint is a
# public address, so without this check a stranger could make the bot message every linked
# student on demand.
#
# Worth setting deliberately rather than skipping: unset, api/daily.ts answers 503 to its
# own cron and no digest is ever sent. Nothing reports that, because a cron with nobody
# watching it looks exactly like a cron with nothing to say.
CRON_SECRET=

# Google Calendar (§1.4's optional supplement). Read only by api/google-connect.ts and
# api/google-disconnect.ts. None of these may ever carry a VITE_ prefix: the client secret
# and the token key both belong to the server, and a VITE_ prefix publishes a value into the
# browser bundle where anybody can read it.
#
# Leave them unset and the connect endpoint answers 503 and the app hides the calendar way in
# entirely -- the state CI, the demo, and any deployment before its secrets are filled in all
# run in. Nothing else about the app changes.
#
# Google Cloud console, APIs & Services, Credentials, OAuth 2.0 Client ID (Web application).
# The authorised redirect URI must be exactly https://<your-host>/api/google-connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Wraps each student's refresh token before it reaches the database, so a dump of
# google_credentials is a column of noise on its own. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating this makes every stored connection unopenable and every student has to connect
# again. That is a safe failure -- disconnect deletes the row and says how to withdraw the
# permission at Google -- but it is not a silent one, so rotate deliberately.
GOOGLE_TOKEN_KEY=
# Signs the `state` carried through the OAuth round trip, which is the whole defence against
# somebody completing a connection to *their* Google account against another student's row.
# Any long random string you invent, and not the one used for TELEGRAM_WEBHOOK_SECRET.
GOOGLE_STATE_SECRET=
