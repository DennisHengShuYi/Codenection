# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Vite inlines every VITE_-prefixed value into the browser bundle verbatim, so the prefix
# is a security boundary rather than a naming convention: only values safe to publish may
# carry it. The Supabase anon key is designed to be public and is safe. The two below it
# are not, and must never gain the prefix.

# Client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only -- /api routes and migrations. Never VITE_-prefixed.
# The connection string carries the database password; the Groq key is billable.
SUPABASE_DIRECT_CONNECTION_STRING=
# Read by api/plan.ts, api/read-photo.ts and api/draft.ts -- nothing else, ever.
# Leave it unset and two of the three still work: the planner falls back to its rule-based
# parser and the request box to its templates. Photo import has no such fallback -- reading
# an image needs the model -- so it says so plainly rather than guessing at contents.
GROQ_API_KEY=

# Only used by `npm run test:integration`, which runs the storage contract against a real
# Supabase project. Use a throwaway account: the contract clears the store before every
# test, so whatever this account owns is deleted. Never a real student's login.
INTEGRATION_TEST_EMAIL=
INTEGRATION_TEST_PASSWORD=

# The Telegram bot (§13). Read only by api/telegram.ts. Never VITE_-prefixed: the bot token
# lets anyone send as the bot, and the service-role key bypasses row-level security
# entirely, so whoever holds it can read and write every student's week.
#
# Leave them unset and the webhook answers 503 rather than erroring, which is the state CI
# and the demo both run in -- the app itself is unaffected either way.
TELEGRAM_BOT_TOKEN=
# Any long random string you invent. Telegram sends it back on every call, and it is the
# only thing standing between this endpoint and anyone on the internet.
TELEGRAM_WEBHOOK_SECRET=
# Supabase dashboard, Project Settings, API. The most dangerous value in this file.
SUPABASE_SERVICE_ROLE_KEY=
